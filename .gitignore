# ── Large data / volumes (keep local; GitHub rejects >100 MB files) ──────────
# Shared .trk/.nii(.gz) live in data/; ignored anywhere by extension.
*.trk
*.nii
*.nii.gz

# ── C++ build output ─────────────────────────────────────────────────────────
build/
*.obj
*.exe
*.pdb
*.ilk

# Stray in-source CMake artifacts (builds must go in build/; CMakeLists.txt also
# hard-errors on in-source configure). Anchored to root so nested ones still show.
/CMakeCache.txt
/CMakeFiles/
/Makefile
/cmake_install.cmake
/CTestTestfile.cmake
/DartConfiguration.tcl
/Testing/
/.qt/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# ── Local Claude Code config (per-machine permission allowlist) ──────────────
.claude/

# ── External Claude Code skills/plugins repo cloned in-tree (own .git) ───────
agent-skills/

# ── Debug / scratch screenshots ──────────────────────────────────────────────
debug_*
ui_*.png
*.ppm

# ── Draft manuscript (placeholder-laden .md + regenerable .docx) ─────────────
# Not tracked while in draft; revisit and track manuscript/*.md once finalized.
manuscript/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
