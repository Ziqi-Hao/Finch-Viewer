#version 440
// Trivial compute shader whose ONLY job is to prove the Qt RHI -> Metal compute
// path works end to end on this machine: write vals[i] = i*2 into a storage buffer
// that the host reads back and checks. Mirrors the storage-buffer + UBO layout the
// real ODF deform kernel will use (std430 SSBO out, std140 UBO in).
layout(local_size_x = 64) in;

layout(std430, binding = 0) writeonly buffer OutBuf { float vals[]; };
layout(std140, binding = 1) uniform UBO { int n; } ubo;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(ubo.n)) return;
    vals[i] = float(i) * 2.0;
}
