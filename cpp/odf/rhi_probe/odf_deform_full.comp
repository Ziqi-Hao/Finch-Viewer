#version 430
// Full GPU ODF glyph build — the fused path that replaces CPU BuildGlyphs.
// ONE invocation per voxel owns that glyph's whole SSBO region [vbase, vbase+nDir),
// so radii/positions/normals are computed with NO cross-invocation atomics (the same
// trick as dmri-explorer's per-voxel compute dispatch). Math mirrors glyph_builder.cpp
// bit-for-bit so the GPU output equals the verified CPU oracle.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Coeffs  { float coeffs[]; };     // [nVox*nCoeffs] voxel-major
layout(std430, binding = 1) readonly buffer Basis   { float basis[];  };     // [nDir*nCoeffs] dir-major (== ShBasisMatrix.values)
layout(std430, binding = 2) readonly buffer Dirs    { vec4 sphereDir[]; };   // [nDir] unit icosphere directions
layout(std430, binding = 3) readonly buffer Idx     { uint sphereIdx[]; };   // [nTri*3] icosphere triangle indices
layout(std430, binding = 4) readonly buffer Centers { vec4 voxCenter[]; };   // [nVox] VoxelToWorld(affine, voxel)
layout(std430, binding = 5)          buffer Radii   { float radii[]; };      // [nVox*nDir] scratch
layout(std430, binding = 6)          buffer Pos     { vec4 positions[]; };   // [nVox*nDir] out (read back in pass C)
layout(std430, binding = 7)          buffer Nor     { vec4 normals[]; };     // [nVox*nDir] out

layout(std140, binding = 8) uniform UBO {
    int nVox; int nDir; int nTri; int nCoeffs;
    float scale; int normalizePerGlyph; int clampNegative; float edgeEps;
} ubo;

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= uint(ubo.nVox)) return;
    uint vbase = g * uint(ubo.nDir);
    uint cbase = g * uint(ubo.nCoeffs);

    // A) radius[v] = sum_c coeff*basis ; clamp negatives ; track per-glyph max
    float maxAmp = 0.0;
    for (int v = 0; v < ubo.nDir; ++v) {
        uint bbase = uint(v) * uint(ubo.nCoeffs);
        float r = 0.0;
        for (int c = 0; c < ubo.nCoeffs; ++c)
            r += coeffs[cbase + uint(c)] * basis[bbase + uint(c)];
        if (ubo.clampNegative != 0 && r < 0.0) r = 0.0;
        radii[vbase + uint(v)] = r;
        if (r > maxAmp) maxAmp = r;
    }
    float normFactor = (ubo.normalizePerGlyph != 0 && maxAmp > 0.0) ? (1.0 / maxAmp) : 1.0;
    float radiusScale = normFactor * ubo.scale;

    // B) deformed world position; zero the normal accumulator
    vec3 ctr = voxCenter[g].xyz;
    for (int v = 0; v < ubo.nDir; ++v) {
        vec3 off = sphereDir[v].xyz * (radii[vbase + uint(v)] * radiusScale);
        positions[vbase + uint(v)] = vec4(ctr + off, 1.0);
        normals[vbase + uint(v)] = vec4(0.0);
    }
    memoryBarrierBuffer();  // positions written above are read below (same invocation)

    // C) accumulate face normals from the DEFORMED surface (skip degenerate tris)
    for (int t = 0; t < ubo.nTri * 3; t += 3) {
        uint i0 = sphereIdx[t]; uint i1 = sphereIdx[t + 1]; uint i2 = sphereIdx[t + 2];
        vec3 a = positions[vbase + i0].xyz;
        vec3 b = positions[vbase + i1].xyz;
        vec3 c = positions[vbase + i2].xyz;
        vec3 ab = b - a, ac = c - a;
        if (length(ab) > ubo.edgeEps && length(ac) > ubo.edgeEps) {
            ab = normalize(ab); ac = normalize(ac);
            if (abs(dot(ab, ac)) < 1.0) {
                vec3 n = normalize(cross(ab, ac));
                normals[vbase + i0] = vec4(normals[vbase + i0].xyz + n, 0.0);
                normals[vbase + i1] = vec4(normals[vbase + i1].xyz + n, 0.0);
                normals[vbase + i2] = vec4(normals[vbase + i2].xyz + n, 0.0);
            }
        }
    }

    // D) normalize accumulated normals
    for (int v = 0; v < ubo.nDir; ++v) {
        vec3 n = normals[vbase + uint(v)].xyz;
        float l = length(n);
        normals[vbase + uint(v)] = vec4(l > 0.0 ? n / l : vec3(0.0), 0.0);
    }
}
