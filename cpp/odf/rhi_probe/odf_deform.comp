#version 430
// The real ODF deform kernel: per (voxel, sphere-direction), the glyph radius is
// the SH reconstruction  r = sum_c coeff[voxel][c] * basis[dir][c].
// This is the GPU port of glyph_builder.cpp's CPU matvec (and of dmri-explorer's
// per-vertex shader eval). One invocation per (voxel, direction) pair.
//
// Layouts (must match the host repack):
//   coeffs : voxel-major  [nVox * nCoeffs], coeff(v,c) = coeffs[v*nCoeffs + c]
//   basis  : dir-major    [nDir * nCoeffs], basis(d,c) = basis[d*nCoeffs + c]   (== ShBasisMatrix.values)
//   radii  : [nVox * nDir], radii[v*nDir + d]
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Coeffs { float coeffs[]; };
layout(std430, binding = 1) readonly  buffer Basis  { float basis[];  };
layout(std430, binding = 2) writeonly buffer Radii  { float radii[];  };
layout(std140, binding = 3) uniform UBO { int nVox; int nDir; int nCoeffs; } ubo;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = uint(ubo.nVox) * uint(ubo.nDir);
    if (idx >= total) return;

    uint voxel = idx / uint(ubo.nDir);
    uint dir   = idx - voxel * uint(ubo.nDir);
    uint cbase = voxel * uint(ubo.nCoeffs);
    uint bbase = dir   * uint(ubo.nCoeffs);

    float s = 0.0;
    for (int c = 0; c < ubo.nCoeffs; ++c)
        s += coeffs[cbase + uint(c)] * basis[bbase + uint(c)];

    radii[idx] = s;
}
